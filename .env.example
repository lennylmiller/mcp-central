# Copy this to .env and fill in the real values.
# .env is gitignored — do not commit.
#
# After editing, run: ./scripts/apply-all.sh
# That will render the configs for Claude Code, Gemini CLI, and Codex CLI.

# Required by the `magic` server (21st.dev component builder)
# Get one at: https://21st.dev
TWENTYFIRST_API_KEY=

# Required by the `morphllm-fast-apply` server
# Get one at: https://morphllm.com
MORPH_API_KEY=
